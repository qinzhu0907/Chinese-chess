# 复制为 .env 后按需修改（本项目不依赖任何密钥，全部变量都可省略走默认值）

# 服务监听端口（部署到服务器时通常保持 3000，由 Nginx 反向代理）
PORT=3000

# 监听地址，容器内保持 0.0.0.0
HOST=0.0.0.0

# production / development，仅影响日志输出
NODE_ENV=production

# 每步限时（秒）。0 表示不限制。玩家建房时可自行选择，这是默认值
PER_MOVE=60

# 掉线宽限（毫秒）：断线后座位保留多久，期间可用 token 重连回原位
RECONNECT_GRACE=120000

# 房间数上限，防止被刷爆内存
MAX_ROOMS=4000

# 允许跨域的前端来源，多个用逗号分隔；留空则不允许跨域（同域部署无需设置）
# CORS_ORIGIN=https://chess.example.com
